{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "任意のドキュメントサイトを取得するためのワイルドカード HTTP 権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
